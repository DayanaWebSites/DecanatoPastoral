---
export const prerender = false;
import AuthShell from '../layouts/AuthShell.astro';
import LoginForm from '../components/editor/LoginForm';
import auth from '../data/auth.json';

const raw = Astro.url.searchParams.get('next') || '/editar';
const next = raw.startsWith('/') && !raw.startsWith('//') ? raw : '/editar';
---

<AuthShell titulo={auth.login.titulo} subtitulo={auth.login.subtitulo}>
  <LoginForm client:load next={next} />
</AuthShell>
