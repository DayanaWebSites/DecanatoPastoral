---
import { getCollection, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Boton from '../../components/ui/Boton.astro';
import Aviso from '../../components/ui/Aviso.astro';

export async function getStaticPaths() {
  const comedores = await getCollection('comedores');
  return comedores.map((c) => ({ params: { slug: c.id }, props: { comedor: c } }));
}

interface Props { comedor: CollectionEntry<'comedores'> }
const { comedor } = Astro.props;
const d = comedor.data;

const imagenes = import.meta.glob<{ default: ImageMetadata }>('../../assets/comedores/*.webp', { eager: true });
const fotos = d.fotos
  .map((f) => ({ ...f, src: imagenes[`../../assets/comedores/${f.archivo}`]?.default }))
  .filter((f) => f.src);

const sitio = Astro.site?.toString() ?? 'https://pastoralsocialdecanatodulcenombre.org';
const urlPagina = new URL(`/comedores/${comedor.id}`, sitio).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FoodEstablishment',
      additionalType: 'https://schema.org/SocialService',
      name: d.nombre,
      description: d.resumen,
      url: urlPagina,
      isAccessibleForFree: true,
      address: { '@type': 'PostalAddress', streetAddress: d.direccion, addressLocality: 'Guadalajara', addressRegion: 'Jalisco', addressCountry: 'MX' },
      ...(d.telefono ? { telephone: d.telefono } : {}),
      parentOrganization: { '@type': 'Organization', name: d.parroquia },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL('/', sitio).toString() },
        { '@type': 'ListItem', position: 2, name: 'Comedores', item: new URL('/comedores', sitio).toString() },
        { '@type': 'ListItem', position: 3, name: d.nombre, item: urlPagina },
      ],
    },
  ],
};
---
<Base
  titulo={d.nombre}
  descripcion={`${d.resumen} ${d.direccion}, Guadalajara. ${d.horario.dias} de ${d.horario.inicio} a ${d.horario.fin}.`}
  jsonLd={jsonLd}
>

  <section class="bg-verde-900 pt-14 text-crema">
    <div class="contenedor">
      <nav aria-label="Migas de pan" class="text-sm text-crema/80">
        <a class="underline-offset-4 hover:text-oro-300 hover:underline" href="/comedores">Comedores</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <span class="text-crema">{d.nombre}</span>
      </nav>
      <p class="mt-6 text-xs font-bold uppercase tracking-[0.2em] text-oro-400">{d.parroquia}</p>
      <h1 class="mt-3 font-serif text-4xl font-semibold leading-tight sm:text-5xl">{d.nombre}</h1>
      <p class="mt-5 max-w-2xl text-[17px] leading-relaxed text-crema/90">{d.resumen}</p>
    </div>
    <div class="filete mt-12" aria-hidden="true"></div>
  </section>

  <!-- Datos duros -->
  <section class="border-b border-arena bg-arena/50">
    <div class="contenedor grid gap-7 py-10 sm:grid-cols-2">
      <div class="flex gap-3">
        <svg class="mt-1 h-5 w-5 shrink-0 text-oro-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 21s7-6.3 7-11a7 7 0 1 0-14 0c0 4.7 7 11 7 11Z" /><circle cx="12" cy="10" r="2.5" /></svg>
        <div>
          <h2 class="text-xs font-bold uppercase tracking-[0.14em] text-verde-700">Dónde está</h2>
          <p class="mt-1 text-[17px] font-medium text-verde-900">{d.direccion}</p>
          <p class="text-sm text-grafito">{d.ciudad}</p>
        </div>
      </div>
      <div class="flex gap-3">
        <svg class="mt-1 h-5 w-5 shrink-0 text-oro-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" stroke-linecap="round" /></svg>
        <div>
          <h2 class="text-xs font-bold uppercase tracking-[0.14em] text-verde-700">Cuándo abre</h2>
          <p class="mt-1 text-[17px] font-medium text-verde-900">{d.horario.dias}</p>
          <p class="text-sm text-grafito">de {d.horario.inicio} a {d.horario.fin}</p>
        </div>
      </div>
    </div>
  </section>

  <div class="contenedor grid gap-14 py-16 lg:grid-cols-[1.15fr_0.85fr]">
    <div>
      {d.cifras.length > 0 && (
        <section aria-labelledby="h-cifras">
          <h2 id="h-cifras" class="font-serif text-2xl font-semibold text-verde-900">Lo que se sirve</h2>
          <div class="mt-6 grid gap-5 sm:grid-cols-2">
            {d.cifras.map((c) => (
              <div class="emerger rounded-xl2 border border-arena bg-white p-6 shadow-sm">
                <p class="font-serif text-4xl font-semibold text-verde-700 tabular-nums">{c.valor}</p>
                <p class="mt-1 font-semibold text-verde-900">{c.etiqueta}</p>
                {c.detalle && <p class="mt-1.5 text-sm leading-relaxed text-grafito">{c.detalle}</p>}
              </div>
            ))}
          </div>
        </section>
      )}

      {d.jornada.length > 0 && (
        <section class="mt-14" aria-labelledby="h-jornada">
          <h2 id="h-jornada" class="font-serif text-2xl font-semibold text-verde-900">Cómo es la jornada</h2>
          <ol class="mt-6 space-y-1">
            {d.jornada.map((j) => (
              <li class="flex gap-5 border-l-2 border-oro-300 py-3 pl-5">
                <span class="w-28 shrink-0 font-semibold tabular-nums text-oro-700">{j.hora}</span>
                <span class="text-[15px] leading-relaxed text-tinta/85">{j.que}</span>
              </li>
            ))}
          </ol>
        </section>
      )}

      {d.notas.length > 0 && (
        <div class="mt-10 space-y-4">
          {d.notas.map((n) => <Aviso>{n}</Aviso>)}
        </div>
      )}
    </div>

    <aside class="lg:sticky lg:top-28 lg:self-start">
      <div class="rounded-xl2 border border-verde-200 bg-verde-50 p-7">
        <h2 class="font-serif text-2xl font-semibold text-verde-900">Cómo puedes ayudar aquí</h2>
        <ul class="mt-5 space-y-3">
          {d.comoAyudar.map((a) => (
            <li class="flex gap-3 text-[15px] leading-relaxed text-tinta/85">
              <svg class="mt-1 h-4 w-4 shrink-0 text-verde-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M20 6 9 17l-5-5" stroke-linecap="round" stroke-linejoin="round" /></svg>
              <span>{a}</span>
            </li>
          ))}
        </ul>
        <div class="mt-7">
          <Boton href="/ayudar" class="w-full">Quiero sumarme</Boton>
        </div>
      </div>
    </aside>
  </div>

  {fotos.length > 0 && (
    <section class="contenedor pb-20" aria-labelledby="h-fotos">
      <h2 id="h-fotos" class="font-serif text-2xl font-semibold text-verde-900">El comedor por dentro</h2>
      <p class="mt-2 max-w-2xl text-sm text-grafito">
        Publicamos estas fotografías con el rostro de las personas atendidas difuminado, para
        cuidar su identidad y su dignidad.
      </p>
      <div class="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {fotos.map((f) => (
          <Image
            src={f.src!}
            alt={f.alt}
            widths={[320, 480, 640]}
            sizes="(min-width: 1024px) 260px, (min-width: 640px) 46vw, 92vw"
            quality={68}
            loading="lazy"
            class="emerger aspect-[4/3] w-full rounded-xl2 object-cover shadow-sm ring-1 ring-arena"
          />
        ))}
      </div>
    </section>
  )}
</Base>
