---
export const prerender = true;
import Base from '../layouts/Base.astro';
import Boton from '../components/ui/Boton.astro';
---
<Base
  titulo="Gracias"
  descripcion="Recibimos tus datos. La Pastoral Social del Decanato Dulce Nombre de Jesús se pondrá en contacto contigo."
  noindex={true}
>
  <section class="bg-verde-900 pt-16 text-crema">
    <div class="contenedor">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-oro-400">Pastoral Social</p>
      <h1 class="mt-3 font-serif text-4xl font-semibold sm:text-5xl">Gracias por sumarte</h1>
      <p class="mt-5 max-w-2xl text-[17px] leading-relaxed text-crema/90">
        Recibimos tus datos. Nos pondremos en contacto para decirte cómo y cuándo
        puedes ayudar en el comedor.
      </p>
    </div>
    <div class="filete mt-12" aria-hidden="true"></div>
  </section>

  <section class="contenedor-angosto py-16">
    <p class="text-[17px] leading-relaxed text-tinta/85">
      Mientras tanto puedes conocer los tres comedores, sus horarios y cómo llegar.
    </p>
    <div class="mt-10 flex flex-wrap gap-3">
      <Boton href="/comedores">Ver los comedores</Boton>
      <Boton href="/" variante="secundario">Volver al inicio</Boton>
    </div>
  </section>
</Base>
