---
import { Image } from 'astro:assets';
import logo from '../../assets/decanato/logo-claro.webp';

const enlaces = [
  { href: '/comedores', texto: 'Comedores' },
  { href: '/parroquias', texto: 'Parroquias' },
  { href: '/pastoral-social', texto: 'Pastoral Social' },
  { href: '/ayudar', texto: 'Quiero ayudar' },
];
const ruta = Astro.url.pathname.replace(/\/$/, '') || '/';
const activo = (h: string) => ruta === h || ruta.startsWith(h + '/');
---

<header class="sticky top-0 z-50 border-b border-verde-800/40 bg-verde-900/95 backdrop-blur-md">
  <div class="contenedor flex items-center gap-4 py-3">
    <a href="/" class="flex shrink-0 items-center gap-3 text-crema">
      <Image src={logo} alt="" width={44} height={44} densities={[2]} loading="eager" class="h-11 w-11 rounded-full ring-1 ring-oro-500/50" />
      <span class="leading-tight">
        <span class="block font-serif text-[15px] font-semibold sm:text-base">Pastoral Social</span>
        <span class="block text-xs uppercase tracking-[0.14em] text-oro-300">Dulce Nombre de Jesús</span>
      </span>
    </a>

    <nav class="ml-auto hidden items-center gap-1 md:flex" aria-label="Navegación principal">
      {enlaces.map((e) => (
        <a
          href={e.href}
          aria-current={activo(e.href) ? 'page' : undefined}
          class:list={[
            'rounded-full px-4 py-2 text-sm font-medium transition-colors',
            activo(e.href)
              ? 'bg-oro-500 text-verde-900'
              : 'text-crema/85 hover:bg-verde-800 hover:text-crema',
          ]}
        >{e.texto}</a>
      ))}
    </nav>

    <!-- Menú móvil sin JS: <details> nativo -->
    <details class="ml-auto md:hidden [&[open]_.abrir]:hidden [&:not([open])_.cerrar]:hidden">
      <summary class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-lg text-crema marker:hidden [&::-webkit-details-marker]:hidden" aria-label="Abrir menú">
        <svg class="abrir h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" /></svg>
        <svg class="cerrar h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" /></svg>
      </summary>
      <nav class="absolute inset-x-0 top-full border-b border-verde-800 bg-verde-900 px-5 pb-5 pt-1 shadow-xl" aria-label="Navegación principal">
        {enlaces.map((e) => (
          <a
            href={e.href}
            aria-current={activo(e.href) ? 'page' : undefined}
            class:list={[
              'block rounded-lg px-4 py-3 text-[15px] font-medium',
              activo(e.href) ? 'bg-oro-500 text-verde-900' : 'text-crema/90 hover:bg-verde-800',
            ]}
          >{e.texto}</a>
        ))}
      </nav>
    </details>
  </div>
  <div class="filete" aria-hidden="true"></div>
</header>
