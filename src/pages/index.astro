---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Boton from '../components/ui/Boton.astro';
import TarjetaComedor from '../components/ui/TarjetaComedor.astro';
import TarjetaParroquia from '../components/ui/TarjetaParroquia.astro';
import Cita from '../components/ui/Cita.astro';
import logo from '../assets/decanato/logo-claro.webp';
import heroFoto from '../assets/comedores/el-tepeyac-01-comidas-servidas.webp';
import textos from '../data/textos.json';
import decanato from '../data/decanato.json';

const comedores = (await getCollection('comedores')).sort((a, b) => a.data.orden - b.data.orden);
const parroquias = (await getCollection('parroquias')).sort((a, b) => a.data.orden - b.data.orden);

const cifras = [
  { valor: '3', etiqueta: 'comedores asistenciales', pie: 'abiertos cada semana en el decanato' },
  { valor: '270+', etiqueta: 'alimentos cada semana', pie: 'entre desayunos, comidas y lonches' },
  { valor: '13', etiqueta: 'parroquias', pie: 'que forman el decanato' },
];
---

<Base
  titulo="inicio"
  descripcion="Tres comedores asistenciales del Decanato Dulce Nombre de Jesús en Guadalajara. Conoce dónde están, cómo sumarte como voluntario o bienhechor y a dónde canalizar a quien necesita comer."
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-verde-900 text-crema">
    <div
      class="pointer-events-none absolute -right-24 -top-24 h-[28rem] w-[28rem] rounded-full bg-verde-700/40 blur-3xl"
      aria-hidden="true"
    ></div>
    <div class="contenedor relative grid items-center gap-12 py-16 lg:grid-cols-[1.05fr_0.95fr] lg:py-24">
      <div>
        <Image src={logo} alt="" width={80} height={80} densities={[2]} loading="eager" class="h-20 w-20 rounded-full ring-1 ring-oro-500/40" />
        <p class="mt-7 text-xs font-bold uppercase tracking-[0.22em] text-oro-400">
          {textos.hero.kicker} · {decanato.nombre}
        </p>
        <h1 class="mt-4 font-serif text-4xl font-semibold leading-[1.12] sm:text-5xl lg:text-[3.4rem]">
          {textos.hero.titulo}
        </h1>
        <p class="mt-5 max-w-xl font-serif text-xl italic text-oro-200">{textos.hero.entrada}</p>
        <p class="mt-6 max-w-xl text-[17px] leading-relaxed text-crema/90">
          En el decanato sostenemos tres comedores asistenciales. Aquí encuentras dónde están,
          a qué hora abren y cómo puedes sumarte: como voluntario, como bienhechor o
          acompañando a quien necesita un plato de comida.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <Boton href={textos.hero.ctaPrimario.href}>{textos.hero.ctaPrimario.texto}</Boton>
          <Boton href={textos.hero.ctaSecundario.href} variante="claro">{textos.hero.ctaSecundario.texto}</Boton>
        </div>
      </div>

      <div class="relative">
        <Image
          src={heroFoto}
          alt="Charolas con comida servida y bolsas de alimento listas para entregar en el comedor"
          widths={[400, 640, 800]}
          sizes="(min-width: 1024px) 480px, 92vw"
          quality={70}
          loading="eager"
          fetchpriority="high"
          class="aspect-[4/3] w-full rounded-xl2 object-cover shadow-2xl ring-1 ring-oro-500/25"
        />
        <div class="absolute -bottom-5 left-5 rounded-xl2 bg-oro-500 px-5 py-3 text-verde-900 shadow-lg sm:left-8">
          <p class="font-serif text-2xl font-semibold leading-none">Todos los días</p>
          <p class="mt-1 text-xs font-semibold uppercase tracking-wider">hay alguien esperando</p>
        </div>
      </div>
    </div>
    <div class="filete" aria-hidden="true"></div>
  </section>

  <!-- Cifras -->
  <section class="border-b border-arena bg-arena/50" aria-label="El decanato en números">
    <div class="contenedor grid gap-8 py-12 sm:grid-cols-3">
      {cifras.map((c) => (
        <div class="emerger text-center sm:text-left">
          <p class="font-serif text-4xl font-semibold text-verde-700 tabular-nums">{c.valor}</p>
          <p class="mt-1 text-sm font-semibold text-verde-900">{c.etiqueta}</p>
          <p class="mt-1 text-sm text-grafito">{c.pie}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Comedores -->
  <section class="contenedor py-20" aria-labelledby="h-comedores">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-oro-700">Lo que sostiene el decanato</p>
      <h2 id="h-comedores" class="mt-3 font-serif text-3xl font-semibold text-verde-900 sm:text-4xl">
        Tres comedores asistenciales
      </h2>
      <p class="mt-4 text-[17px] leading-relaxed text-grafito">
        Cada uno con su propio horario y su propia manera de servir. Si conoces a alguien que
        necesita comer, aquí puedes decirle a dónde ir.
      </p>
    </div>

    <div class="mt-12 grid gap-7 md:grid-cols-2 lg:grid-cols-3">
      {comedores.map((c) => <TarjetaComedor comedor={c} />)}
    </div>
  </section>

  <!-- Qué hacemos -->
  <section class="bg-verde-900 py-20 text-crema" aria-labelledby="h-hacemos">
    <div class="contenedor">
      <div class="mx-auto max-w-2xl text-center">
        <h2 id="h-hacemos" class="font-serif text-3xl font-semibold sm:text-4xl">{textos.queHacemos.titulo}</h2>
        <p class="mt-4 text-[17px] leading-relaxed text-crema/90">{textos.queHacemos.entrada}</p>
      </div>

      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {textos.queHacemos.acciones.map((a) => (
          <li class="emerger rounded-xl2 border border-verde-800 bg-verde-800/50 p-6">
            <h3 class="font-serif text-xl font-semibold text-oro-300">{a.titulo}</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-crema/90">{a.texto}</p>
          </li>
        ))}
      </ul>

      <p class="contenedor-angosto mt-12 text-center text-[17px] leading-relaxed text-crema/90">
        {textos.queHacemos.cierre}
      </p>

      <div class="mt-10 flex justify-center">
        <Boton href="/pastoral-social" variante="claro">Conoce la Pastoral Social</Boton>
      </div>
    </div>
  </section>

  <!-- Cita -->
  <section class="contenedor-angosto py-20">
    <Cita texto={textos.citas.lista[0].texto} fuente={textos.citas.lista[0].fuente} />
  </section>

  <!-- Parroquias -->
  <section class="contenedor pb-20" aria-labelledby="h-parroquias">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-oro-700">El decanato</p>
      <h2 id="h-parroquias" class="mt-3 font-serif text-3xl font-semibold text-verde-900 sm:text-4xl">
        Nuestras {parroquias.length} parroquias
      </h2>
      <p class="mt-4 text-[17px] leading-relaxed text-grafito">
        Cada parroquia tiene su propia ficha. Poco a poco iremos publicando lo que ofrece cada una:
        dispensario, despensas, comedor y sus contactos.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-4">
      {parroquias.slice(0, 8).map((p) => <TarjetaParroquia parroquia={p} />)}
    </div>

    <div class="mt-10 flex justify-center">
      <Boton href="/parroquias" variante="secundario">Ver las {parroquias.length} parroquias</Boton>
    </div>
  </section>

  <!-- CTA final -->
  <section class="contenedor pb-4">
    <div class="emerger overflow-hidden rounded-xl2 bg-gradient-to-br from-verde-800 to-verde-950 px-8 py-14 text-center text-crema sm:px-14">
      <h2 class="font-serif text-3xl font-semibold sm:text-4xl">{textos.invitacion.titulo}</h2>
      <p class="contenedor-angosto mt-5 text-[17px] leading-relaxed text-crema/85">
        {textos.invitacion.parrafos[1]}
      </p>
      <p class="mt-3 font-serif text-2xl italic text-oro-300">{textos.invitacion.parrafos[2]}</p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <Boton href="/ayudar">Quiero ser voluntario</Boton>
        <Boton href="/comedores" variante="claro">Ver los comedores</Boton>
      </div>
    </div>
  </section>
</Base>
