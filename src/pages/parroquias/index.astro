---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TarjetaParroquia from '../../components/ui/TarjetaParroquia.astro';
import Aviso from '../../components/ui/Aviso.astro';

const parroquias = (await getCollection('parroquias')).sort((a, b) => a.data.orden - b.data.orden);
const pendientes = parroquias.filter((p) => p.data.estado === 'en_construccion').length;
---
<Base
  titulo="Parroquias del decanato"
  descripcion="Las 13 parroquias que conforman el Decanato Dulce Nombre de Jesús de la Arquidiócesis de Guadalajara y los servicios de Pastoral Social que ofrece cada una."
>
  <section class="bg-verde-900 pt-16 text-crema">
    <div class="contenedor">
      <p class="text-xs font-bold uppercase tracking-[0.2em] text-oro-400">Decanato Dulce Nombre de Jesús</p>
      <h1 class="mt-3 font-serif text-4xl font-semibold sm:text-5xl">Nuestras parroquias</h1>
      <p class="mt-5 max-w-2xl text-[17px] leading-relaxed text-crema/90">
        Estas son las {parroquias.length} parroquias que forman el decanato. Da clic en cualquiera
        para ver qué ofrece su Pastoral Social —dispensario, comedor, despensas— y sus contactos.
      </p>
    </div>
    <div class="filete mt-12" aria-hidden="true"></div>
  </section>

  <section class="contenedor py-16">
    <div class="grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-4">
      {parroquias.map((p) => <TarjetaParroquia parroquia={p} />)}
    </div>

    {pendientes > 0 && (
      <div class="contenedor-angosto mt-14 px-0">
        <Aviso titulo="Estamos completando la información">
          {pendientes} de las {parroquias.length} parroquias todavía aparecen en construcción.
          Si perteneces a alguna de ellas y quieres que publiquemos sus servicios y contactos,
          <a class="font-semibold text-verde-700 underline underline-offset-4 hover:text-verde-600" href="/ayudar">escríbenos</a>.
        </Aviso>
      </div>
    )}
  </section>
</Base>
